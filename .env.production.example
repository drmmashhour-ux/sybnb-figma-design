# SYBNB V6 — PRODUCTION environment template (Vercel).
# Copy the values into the Vercel project's Environment Variables (Production scope). This file is a
# PLACEHOLDER template only — never put real secrets here; it is committed. Real values live in Vercel.
#
# Deploy model: the Vite frontend and the api/index.mjs serverless function ship together on ONE Vercel
# project/domain (vercel.json rewrites /api/* → /api/index). That makes API calls same-origin, so
# VITE_API_BASE_URL is left empty and CORS effectively does not apply to the app's own requests.
#
# One-time DB setup on Neon before the first deploy (Neon gives a DIRECT url and a POOLED "-pooler" url):
#   1. Run migrations against the DIRECT (non-pooler) url — PgBouncer can't do CREATE EXTENSION / the
#      migration advisory lock, and the baseline migration already creates the postgis extension itself:
#        DATABASE_URL="<DIRECT_URL>" npx prisma migrate deploy
#   2. (optional, staging or a store-review env only) demo accounts:
#        DATABASE_URL="<DIRECT_URL>" DEMO_ACCOUNT_PASSWORD=... node scripts/seed-demo-accounts.mjs
#   Do NOT run scripts/seed-14-governorates.mjs against production — it injects 14 demo listings into the
#   real marketplace; governorate reference data is bundled in the frontend and needs no seeding.

# ============================== REQUIRED (app will not run correctly without these) ==============================

# Neon POOLED connection string (the "-pooler" host), pgbouncer required for serverless concurrency.
# This is the RUNTIME url only. Migrations use the DIRECT (non-pooler) url — see the setup notes above.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/sybnb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Long random strings (>=16 chars). Rotating AUTH_SECRET invalidates all sessions.
AUTH_SECRET="replace-with-a-long-random-value-min-16-chars"
PHONE_HASH_SECRET="replace-with-a-different-long-random-value-min-16-chars"

# Enables production behavior (HSTS, config validation at cold start, same-origin API base).
NODE_ENV="production"

# Comma-separated allowed frontend origin(s) for CORS. Put the REAL deployed origin here, e.g. the Vercel
# domain and/or the custom domain. Same-origin app requests don't need it, but it must be set explicitly in
# production (validateProductionConfig fails startup if unset). Capacitor origins are always allowed in code.
CORS_ORIGIN="https://app.sybnb.app,https://sybnb.app"

# On Vercel every request passes through the edge proxy, so the real client IP is only in x-forwarded-for.
TRUST_PROXY="1"

# Set once the app is actually served over HTTPS (Vercel always is) so HSTS is emitted.
FORCE_HTTPS="1"

# Frontend API base. LEAVE EMPTY for the same-origin Vercel deploy (relative /api/... calls). Only set to a
# full URL if the API is ever split onto its own domain.
VITE_API_BASE_URL=""

# ============================== STRIPE (card top-ups / payments) ==============================
# Without these, card payment flows are disabled; wallet/Sham-cash flows still work.
STRIPE_SECRET_KEY="sk_live_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_CURRENCY="usd"
SYP_PER_USD="15000"
# Publishable key is public by design — VITE_-prefixed so it's bundled into the frontend.
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_replace_me"

# ============================== EMAIL (verification codes, host-insight emails) ==============================
# Without a provider, verification emails don't send (prod records the failure; no devCode in production).
EMAIL_PROVIDER="resend"                     # "resend" or "smtp"
EMAIL_FROM="no-reply@sybnb.app"
EMAIL_FROM_NAME="SYBNB"
EMAIL_REPLY_TO="info@sybnb.app"
# Option A — Resend (HTTP API):
RESEND_API_KEY="re_replace_me"
# Option B — SMTP (used when EMAIL_PROVIDER=smtp or RESEND_API_KEY unset):
SMTP_HOST="smtp.replace-me.example"
SMTP_PORT="587"
SMTP_USER="replace-me"
SMTP_PASS="replace-me"
SMTP_FROM="SYBNB <no-reply@sybnb.app>"

# ============================== SMS / PHONE OTP (phone sign-in as an alternative to email) ==============================
# Without a provider, phone-code send returns no SMS in production (email path is unaffected).
SMS_PROVIDER="twilio"                       # "twilio" or "http"
# Option A — Twilio:
TWILIO_ACCOUNT_SID="AC_replace_me"
TWILIO_AUTH_TOKEN="replace_me"
TWILIO_FROM="+10000000000"
# Option B — generic HTTP gateway (e.g. a local Syrian provider):
SMS_GATEWAY_URL="https://sms.replace-me.example/send"
SMS_API_KEY="replace_me"

# ============================== OPTIONAL ==============================
# AI host pricing insights (Anthropic). Without it, POST /api/host/insights/generate returns 503.
ANTHROPIC_API_KEY="sk-ant-replace_me"
# Store-reviewer demo accounts seed password (used by scripts/seed-demo-accounts.mjs at deploy time).
DEMO_ACCOUNT_PASSWORD="replace-with-a-strong-demo-password"
# Rate-limit store. On serverless / multi-instance (e.g. Vercel), set this to "db" so limits are
# enforced with a shared Postgres counter across every instance instead of a per-instance in-memory
# Map (which would give each instance its own fresh limit). Leave unset for single-process deploys.
RATE_LIMIT_STORE="db"
# Never set in production:
# DISABLE_RATE_LIMIT="0"
