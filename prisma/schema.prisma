generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model User {
  id                                                                              String                             @id @default(uuid())
  email                                                                           String?                            @unique
  phoneHash                                                                       String?                            @unique @map("phone_hash")
  passwordHash                                                                    String?                            @map("password_hash")
  displayName                                                                     String                             @map("display_name")
  locale                                                                          String                             @default("ar-SY")
  status                                                                          AccountStatus                      @default(ACTIVE)
  idDocumentRef                                                                   String?                            @map("id_document_ref")
  idDocumentSubmittedAt                                                           DateTime?                          @map("id_document_submitted_at")
  idDocumentMimeType                                                              String?                            @map("id_document_mime_type")
  idDocumentStatus                                                                IdDocumentStatus?                  @map("id_document_status")
  idDocumentReviewedById                                                          String?                            @map("id_document_reviewed_by_id")
  idDocumentReviewedAt                                                            DateTime?                          @map("id_document_reviewed_at")
  payoutMethod                                                                    Json?                              @map("payout_method")
  sessionVersion                                                                  Int                                @default(0) @map("session_version")
  referralCode                                                                    String                             @unique @map("referral_code")
  createdAt                                                                       DateTime                           @default(now()) @map("created_at")
  updatedAt                                                                       DateTime                           @updatedAt @map("updated_at")
  deletedAt                                                                       DateTime?                          @map("deleted_at")
  isDemo                                                                          Boolean                            @default(false) @map("is_demo")
  accommodations                                                                  Accommodation[]                    @relation("AccommodationOwner")
  auditLogs                                                                       AdminAuditLog[]                    @relation("AuditActor")
  auctionBids                                                                     Bid[]                              @relation("AuctionBidder")
  bookings                                                                        Booking[]                          @relation("BookingGuest")
  disputesOpened                                                                  Dispute[]                          @relation("DisputeOpener")
  driverCancellations                                                             DriverCancellation[]               @relation("DriverCancellationDriver")
  driverDocuments                                                                 DriverDocument[]                   @relation("DriverDocumentOwner")
  driverDocumentsReviewed                                                         DriverDocument[]                   @relation("DriverDocumentReviewer")
  driverProfile                                                                   DriverProfile?
  driverVehicles                                                                  DriverVehicle[]                    @relation("DriverVehicleOwner")
  hostInsights                                                                    HostInsight[]                      @relation("HostInsightOwner")
  jurisdiction_compliance_profiles                                                jurisdiction_compliance_profiles[]
  listing_documents_listing_documents_legal_hold_set_by_idTousers                 listing_documents[]                @relation("listing_documents_legal_hold_set_by_idTousers")
  listing_documents_listing_documents_reviewed_by_idTousers                       listing_documents[]                @relation("listing_documents_reviewed_by_idTousers")
  listingReviews                                                                  ListingReview[]                    @relation("ReviewGuest")
  listings                                                                        Listing[]                          @relation("ListingOwner")
  listingInquiries                                                                MessageThread[]                    @relation("ListingInquiryGuest")
  sentMessages                                                                    Message[]                          @relation("MessageSender")
  part_xx_records                                                                 part_xx_records[]
  paymentProofs                                                                   PaymentProof[]                     @relation("PaymentPayer")
  payouts                                                                         payouts[]
  quebec_driver_documents_quebec_driver_documents_legal_hold_set_by_idTousers     quebec_driver_documents[]          @relation("quebec_driver_documents_legal_hold_set_by_idTousers")
  quebec_driver_documents_quebec_driver_documents_reviewed_by_idTousers           quebec_driver_documents[]          @relation("quebec_driver_documents_reviewed_by_idTousers")
  quebec_driver_onboarding_quebec_driver_onboarding_assigned_reviewer_idTousers   quebec_driver_onboarding[]         @relation("quebec_driver_onboarding_assigned_reviewer_idTousers")
  quebec_driver_onboarding_quebec_driver_onboarding_reviewed_by_idTousers         quebec_driver_onboarding[]         @relation("quebec_driver_onboarding_reviewed_by_idTousers")
  quebec_vehicle_documents_quebec_vehicle_documents_legal_hold_set_by_idTousers   quebec_vehicle_documents[]         @relation("quebec_vehicle_documents_legal_hold_set_by_idTousers")
  quebec_vehicle_documents_quebec_vehicle_documents_reviewed_by_idTousers         quebec_vehicle_documents[]         @relation("quebec_vehicle_documents_reviewed_by_idTousers")
  quebec_vehicle_onboarding_quebec_vehicle_onboarding_assigned_reviewer_idTousers quebec_vehicle_onboarding[]        @relation("quebec_vehicle_onboarding_assigned_reviewer_idTousers")
  quebec_vehicle_onboarding_quebec_vehicle_onboarding_reviewed_by_idTousers       quebec_vehicle_onboarding[]        @relation("quebec_vehicle_onboarding_reviewed_by_idTousers")
  referredAs                                                                      Referral?                          @relation("ReferralReferee")
  referralsMade                                                                   Referral[]                         @relation("ReferralReferrer")
  rideMessagesSent                                                                RideMessage[]                      @relation("RideMessageSender")
  rideRatingsReceived                                                             RideRating[]                       @relation("RideRatingRated")
  rideRatingsGiven                                                                RideRating[]                       @relation("RideRatingRater")
  driverRideMatches                                                               RideRequest[]                      @relation("RideDriver")
  rideRequests                                                                    RideRequest[]                      @relation("RideRider")
  sellerProfile                                                                   SellerProfile?
  sellerReviewsWritten                                                            SellerReview[]                     @relation("SellerReviewBuyer")
  sellerReviewsReceived                                                           SellerReview[]                     @relation("SellerReviewSeller")
  sellerPurchases                                                                 SellerSale[]                       @relation("SellerSaleBuyer")
  sellerSalesMade                                                                 SellerSale[]                       @relation("SellerSaleSeller")
  sosEventsRaised                                                                 SosEvent[]                         @relation("SosRaisedBy")
  sosEventsResolved                                                               SosEvent[]                         @relation("SosResolvedBy")
  tax_profiles_tax_profiles_user_idTousers                                        tax_profiles[]                     @relation("tax_profiles_user_idTousers")
  tax_profiles_tax_profiles_verified_by_idTousers                                 tax_profiles[]                     @relation("tax_profiles_verified_by_idTousers")
  threadDocumentsUploaded                                                         ThreadDocument[]                   @relation("ThreadDocumentUploader")
  roles                                                                           UserRole[]
  claimedGifts                                                                    WalletGift[]                       @relation("GiftRecipient")
  sentGifts                                                                       WalletGift[]                       @relation("GiftSender")
  wallets                                                                         Wallet[]

  @@map("users")
}

model Referral {
  id                  String         @id @default(uuid())
  referrerUserId      String         @map("referrer_user_id")
  refereeUserId       String         @unique @map("referee_user_id")
  status              ReferralStatus @default(PENDING)
  qualifyingBookingId String?        @map("qualifying_booking_id")
  rewardedAt          DateTime?      @map("rewarded_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  referee             User           @relation("ReferralReferee", fields: [refereeUserId], references: [id], onDelete: Cascade)
  referrer            User           @relation("ReferralReferrer", fields: [referrerUserId], references: [id])

  @@index([referrerUserId, status])
  @@map("referrals")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      RoleName
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model SellerProfile {
  id             String        @id @default(uuid())
  userId         String        @unique @map("user_id")
  legalName      String        @map("legal_name")
  sellerType     String        @map("seller_type")
  documentStatus ListingStatus @default(DRAFT) @map("document_status")
  planCode       String?       @map("plan_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model DriverProfile {
  id                       String                    @id @default(uuid())
  userId                   String                    @unique @map("user_id")
  licenseHash              String?                   @map("license_hash")
  vehicleMake              String?                   @map("vehicle_make")
  vehicleModel             String?                   @map("vehicle_model")
  vehiclePlate             String?                   @map("vehicle_plate")
  active                   Boolean                   @default(false)
  lastLocationGeo          Unsupported("geometry")?  @map("last_location_geo")
  payoutMethod             String?                   @map("payout_method")
  payoutAccountRef         String?                   @map("payout_account_ref")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  country                  String                    @default("SY")
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quebec_driver_onboarding quebec_driver_onboarding?

  @@map("driver_profiles")
}

model Location {
  id           String                   @id @default(uuid())
  country      String                   @default("SY")
  governorate  String
  city         String
  area         String?
  street       String?
  addressLine  String?                  @map("address_line")
  geo          Unsupported("geometry")?
  createdAt    DateTime                 @default(now()) @map("created_at")
  listings     Listing[]
  dropoffRides RideRequest[]            @relation("RideDropoff")
  pickupRides  RideRequest[]            @relation("RidePickup")

  @@index([governorate, city])
  @@map("locations")
}

model Listing {
  id                 String                @id @default(uuid())
  ownerId            String                @map("owner_id")
  locationId         String?               @map("location_id")
  accommodationId    String?               @map("accommodation_id")
  division           ListingDivision
  titleAr            String                @map("title_ar")
  titleEn            String?               @map("title_en")
  description        String?
  status             ListingStatus         @default(DRAFT)
  priceMinor         Int                   @map("price_minor")
  currency           String                @default("SYP")
  instantBookEnabled Boolean               @default(false) @map("instant_book_enabled")
  expiresAt          DateTime?             @map("expires_at")
  metadata           Json                  @default("{}")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  auction            Auction?
  bookings           Booking[]
  hostInsights       HostInsight[]
  availability       ListingAvailability[]
  listing_documents  listing_documents[]
  media              ListingMedia[]
  reviews            ListingReview[]
  accommodation      Accommodation?        @relation(fields: [accommodationId], references: [id])
  location           Location?             @relation(fields: [locationId], references: [id])
  owner              User                  @relation("ListingOwner", fields: [ownerId], references: [id])
  inquiryThreads     MessageThread[]
  sales              SellerSale[]

  @@index([division, status])
  @@index([ownerId])
  @@index([accommodationId])
  @@map("listings")
}

model Accommodation {
  id          String               @id @default(uuid())
  ownerId     String               @map("owner_id")
  titleAr     String               @map("title_ar")
  titleEn     String?              @map("title_en")
  description String?
  governorate String
  city        String
  area        String?
  address     String?
  status      ListingStatus        @default(DRAFT)
  metadata    Json                 @default("{}")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  media       AccommodationMedia[]
  owner       User                 @relation("AccommodationOwner", fields: [ownerId], references: [id])
  listings    Listing[]

  @@index([ownerId])
  @@map("accommodations")
}

model AccommodationMedia {
  id              String        @id @default(uuid())
  accommodationId String        @map("accommodation_id")
  url             String
  kind            String
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@index([accommodationId])
  @@map("accommodation_media")
}

model HostInsight {
  id          String    @id @default(uuid())
  hostId      String    @map("host_id")
  listingId   String?   @map("listing_id")
  kind        String    @default("PRICING_GAP")
  facts       Json      @default("{}")
  messageAr   String    @map("message_ar")
  messageEn   String?   @map("message_en")
  aiProvider  String?   @map("ai_provider")
  aiModel     String?   @map("ai_model")
  readAt      DateTime? @map("read_at")
  emailSentAt DateTime? @map("email_sent_at")
  emailError  String?   @map("email_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  host        User      @relation("HostInsightOwner", fields: [hostId], references: [id])
  listing     Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([hostId, createdAt])
  @@index([listingId])
  @@map("host_insights")
}

model Auction {
  id                        String        @id @default(uuid())
  listingId                 String        @unique @map("listing_id")
  status                    AuctionStatus @default(OPEN)
  startingPriceMinor        Int           @map("starting_price_minor")
  reservePriceMinor         Int?          @map("reserve_price_minor")
  reserveMet                Boolean       @default(false) @map("reserve_met")
  minIncrementMinor         Int           @map("min_increment_minor")
  currentPriceMinor         Int           @map("current_price_minor")
  currentBidderId           String?       @map("current_bidder_id")
  currentMaxProxyMinor      Int?          @map("current_max_proxy_minor")
  startsAt                  DateTime      @default(now()) @map("starts_at")
  endsAt                    DateTime      @map("ends_at")
  antiSnipeWindowSeconds    Int           @default(120) @map("anti_snipe_window_seconds")
  antiSnipeExtensionSeconds Int           @default(120) @map("anti_snipe_extension_seconds")
  endedAt                   DateTime?     @map("ended_at")
  winnerBidderId            String?       @map("winner_bidder_id")
  winnerNotifiedAt          DateTime?     @map("winner_notified_at")
  winnerEmailError          String?       @map("winner_email_error")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")
  listing                   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bids                      Bid[]

  @@index([status, endsAt])
  @@map("auctions")
}

model Bid {
  id                  String   @id @default(uuid())
  auctionId           String   @map("auction_id")
  bidderId            String   @map("bidder_id")
  maxProxyMinor       Int      @map("max_proxy_minor")
  visiblePriceAtMinor Int      @map("visible_price_at_minor")
  isWinningBid        Boolean  @default(false) @map("is_winning_bid")
  createdAt           DateTime @default(now()) @map("created_at")
  auction             Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder              User     @relation("AuctionBidder", fields: [bidderId], references: [id])

  @@index([auctionId, createdAt])
  @@index([bidderId])
  @@map("bids")
}

model EmailVerificationCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  purpose    String    @default("guest-signup")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("email_verification_codes")
}

model PhoneVerificationCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String    @default("guest-signup")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("phone_verification_codes")
}

model ListingAvailability {
  id                 String             @id @default(uuid())
  listingId          String             @map("listing_id")
  date               DateTime           @db.Date
  status             AvailabilityStatus @default(BLOCKED)
  priceOverrideMinor Int?               @map("price_override_minor")
  note               String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  listing            Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId, date])
  @@map("listing_availability")
}

model ListingMedia {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  url       String
  kind      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_media")
}

model Booking {
  id                String         @id @default(uuid())
  listingId         String         @map("listing_id")
  guestId           String         @map("guest_id")
  status            BookingStatus  @default(REQUESTED)
  checkIn           DateTime?      @map("check_in")
  checkOut          DateTime?      @map("check_out")
  amountMinor       Int            @map("amount_minor")
  currency          String         @default("SYP")
  metadata          Json           @default("{}")
  guestCheckedInAt  DateTime?      @map("guest_checked_in_at")
  guestCheckedOutAt DateTime?      @map("guest_checked_out_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  guest             User           @relation("BookingGuest", fields: [guestId], references: [id])
  listing           Listing        @relation(fields: [listingId], references: [id])
  disputes          Dispute[]
  review            ListingReview?
  messageThread     MessageThread?
  payments          PaymentProof[]
  legacyPayment     payments?
  legacyPayout      payouts?

  @@index([guestId, status])
  @@index([listingId, status])
  @@map("bookings")
}

model PaymentProof {
  id            String        @id @default(uuid())
  bookingId     String?       @map("booking_id")
  userId        String        @map("user_id")
  provider      String
  status        PaymentStatus @default(PENDING_PROOF)
  amountMinor   Int           @map("amount_minor")
  currency      String        @default("SYP")
  proofAssetUrl String?       @map("proof_asset_url")
  providerRef   String?       @map("provider_ref")
  adminNote     String?       @map("admin_note")
  reviewedById  String?       @map("reviewed_by_id")
  reviewedAt    DateTime?     @map("reviewed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  payer         User          @relation("PaymentPayer", fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("payment_proofs")
}

model ListingReview {
  id              String    @id @default(uuid())
  listingId       String    @map("listing_id")
  bookingId       String    @unique @map("booking_id")
  guestId         String    @map("guest_id")
  rating          Int
  comment         String?
  hiddenAt        DateTime? @map("hidden_at")
  hiddenByAdminId String?   @map("hidden_by_admin_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest           User      @relation("ReviewGuest", fields: [guestId], references: [id])
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, hiddenAt])
  @@map("listing_reviews")
}

model SellerSale {
  id        String        @id @default(uuid())
  listingId String        @map("listing_id")
  sellerId  String        @map("seller_id")
  buyerId   String        @map("buyer_id")
  createdAt DateTime      @default(now()) @map("created_at")
  review    SellerReview?
  buyer     User          @relation("SellerSaleBuyer", fields: [buyerId], references: [id])
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller    User          @relation("SellerSaleSeller", fields: [sellerId], references: [id])

  @@unique([listingId, buyerId])
  @@index([sellerId])
  @@map("seller_sales")
}

model SellerReview {
  id        String     @id @default(uuid())
  saleId    String     @unique @map("sale_id")
  sellerId  String     @map("seller_id")
  buyerId   String     @map("buyer_id")
  rating    Int
  comment   String?
  hiddenAt  DateTime?  @map("hidden_at")
  createdAt DateTime   @default(now()) @map("created_at")
  buyer     User       @relation("SellerReviewBuyer", fields: [buyerId], references: [id])
  sale      SellerSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  seller    User       @relation("SellerReviewSeller", fields: [sellerId], references: [id])

  @@index([sellerId, hiddenAt])
  @@map("seller_reviews")
}

model MessageThread {
  id        String           @id @default(uuid())
  bookingId String?          @unique @map("booking_id")
  listingId String?          @map("listing_id")
  guestId   String?          @map("guest_id")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest     User?            @relation("ListingInquiryGuest", fields: [guestId], references: [id], onDelete: Cascade)
  listing   Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages  Message[]
  documents ThreadDocument[]

  @@unique([listingId, guestId])
  @@map("message_threads")
}

model Message {
  id           String            @id @default(uuid())
  threadId     String            @map("thread_id")
  senderUserId String            @map("sender_user_id")
  senderRole   MessageSenderRole @map("sender_role")
  body         String
  createdAt    DateTime          @default(now()) @map("created_at")
  sender       User              @relation("MessageSender", fields: [senderUserId], references: [id])
  thread       MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("messages")
}

model ThreadDocument {
  id               String        @id @default(uuid())
  threadId         String        @map("thread_id")
  uploaderUserId   String        @map("uploader_user_id")
  assetUrl         String        @map("asset_url")
  mimeType         String        @map("mime_type")
  originalFilename String?       @map("original_filename")
  createdAt        DateTime      @default(now()) @map("created_at")
  thread           MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  uploader         User          @relation("ThreadDocumentUploader", fields: [uploaderUserId], references: [id])

  @@index([threadId, createdAt])
  @@map("thread_documents")
}

model Wallet {
  id                 String        @id @default(uuid())
  userId             String        @map("user_id")
  currency           String        @default("SYP")
  cachedBalanceMinor Int           @default(0) @map("cached_balance_minor")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  entries            WalletEntry[]
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@map("wallets")
}

model WalletEntry {
  id             String          @id @default(uuid())
  walletId       String          @map("wallet_id")
  type           WalletEntryType
  amountMinor    Int             @map("amount_minor")
  currency       String          @default("SYP")
  referenceType  String          @map("reference_type")
  referenceId    String          @map("reference_id")
  idempotencyKey String          @unique @map("idempotency_key")
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at")
  metadata       Json            @default("{}")
  wallet         Wallet          @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_entries")
}

model WalletGift {
  id                 String     @id @default(uuid())
  senderUserId       String     @map("sender_user_id")
  recipientUserId    String?    @map("recipient_user_id")
  recipientPhoneHash String     @map("recipient_phone_hash")
  amountMinor        Int        @map("amount_minor")
  currency           String     @default("SYP")
  message            String?
  status             GiftStatus @default(CREATED)
  claimAttemptCount  Int        @default(0) @map("claim_attempt_count")
  lockedUntil        DateTime?  @map("locked_until")
  expiresAt          DateTime   @map("expires_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  recipient          User?      @relation("GiftRecipient", fields: [recipientUserId], references: [id])
  sender             User       @relation("GiftSender", fields: [senderUserId], references: [id])

  @@index([recipientPhoneHash, status])
