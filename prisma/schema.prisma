model RideRequest {
  id                String                               @id @default(uuid())
  riderId           String                               @map("rider_id")
  driverId          String?                              @map("driver_id")
  pickupLocationId  String?                              @map("pickup_location_id")
  dropoffLocationId String?                              @map("dropoff_location_id")
  status            RideStatus                           @default(REQUESTED)
  requestedAt       DateTime                             @default(now()) @map("requested_at")
  fareMinor         Int?                                 @map("fare_minor")
  currency          String                               @default("SYP")
  pickupGeo         Unsupported("geometry(Point,4326)")? @map("pickup_geo")
  dropoffGeo        Unsupported("geometry(Point,4326)")? @map("dropoff_geo")
  metadata          Json                                 @default("{}")
  updatedAt         DateTime                             @updatedAt @map("updated_at")

  // SR safety layer (014): live driver location during a trip + trip-share token.
  lastLocationGeo     Unsupported("geometry(Point,4326)")? @map("last_location_geo")
  lastLocationAt      DateTime?                            @map("last_location_at")
  shareToken          String?                              @unique @map("share_token")
  shareTokenCreatedAt DateTime?                            @map("share_token_created_at")

  // SR pickup PIN (017): rider-visible 4-digit code the driver enters to confirm the correct rider.
  pickupPin        String?   @map("pickup_pin")
  pickupVerifiedAt DateTime? @map("pickup_verified_at")
  pinAttempts      Int       @default(0) @map("pin_attempts")

  // SR cancellation layer (019): when a driver was matched (grace-window anchor for rider cancels) and
  // the cancellation outcome (who cancelled, why, and any fee charged).
  driverMatchedAt      DateTime? @map("driver_matched_at")
  cancelledAt          DateTime? @map("cancelled_at")
  cancelledByRole      String?   @map("cancelled_by_role")
  cancelReason         String?   @map("cancel_reason")
  cancellationFeeMinor Int?      @map("cancellation_fee_minor")

  rider           User      @relation("RideRider", fields: [riderId], references: [id])
  driver          User?     @relation("RideDriver", fields: [driverId], references: [id])
  pickupLocation  Location? @relation("RidePickup", fields: [pickupLocationId], references: [id])
  dropoffLocation Location? @relation("RideDropoff", fields: [dropoffLocationId], references: [id])

  // SR safety/trust layers (014/015): SOS events, masked ride messaging, two-way ratings.
  sosEvents           SosEvent[]
  messages            RideMessage[]
  ratings             RideRating[]
  driverCancellations DriverCancellation[]
  disputes            Dispute[]

  @@index([status, requestedAt])
  @@index([driverId, status])
  @@map("ride_requests")
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  ipHash      String?  @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_logs")
}

// ============ Jurisdiction compliance (026) ============
// One row per (division, country, region) market SYBNB could operate in. Nothing in that market can
// go live -- a STR listing cannot be APPROVED, an SR driver document cannot be APPROVED -- unless its
// row here has status APPROVED. Every market starts PENDING (fail-closed) until an admin/legal review
// explicitly flips it. Syria is deliberately seeded BLOCKED even though it is SYBNB's original live
// market: local legal review of tourism/transport/tax/platform rules had not been formally confirmed,
// so this profile is the single source of truth admins use to pause/resume a whole market at once
// (see server/lib/jurisdiction-compliance.mjs for the enforcement helpers).
enum JurisdictionDivision {
  STR
  SR

  @@map("jurisdiction_division")
}

enum JurisdictionComplianceStatus {
  PENDING
  APPROVED
  BLOCKED

  @@map("jurisdiction_compliance_status")
}

model JurisdictionComplianceProfile {
  id                          String                       @id @default(uuid())
  division                    JurisdictionDivision
  countryCode                 String                       @map("country_code")
  // '' = whole-country profile (e.g. Syria today); a province/state code (e.g. 'quebec') scopes a
  // profile to one region within a country that regulates STR/SR differently region by region.
  regionCode                  String                       @default("") @map("region_code")
  status                      JurisdictionComplianceStatus @default(PENDING)
  tourismRequired             Boolean                      @default(false) @map("tourism_required")
  tourismSatisfied            Boolean                      @default(false) @map("tourism_satisfied")
  tourismNotes                String?                      @map("tourism_notes")
  transportRequired           Boolean                      @default(false) @map("transport_required")
  transportSatisfied          Boolean                      @default(false) @map("transport_satisfied")
  transportNotes              String?                      @map("transport_notes")
  taxRequired                 Boolean                      @default(false) @map("tax_required")
  taxSatisfied                Boolean                      @default(false) @map("tax_satisfied")
  taxNotes                    String?                      @map("tax_notes")
  platformRequired            Boolean                      @default(false) @map("platform_required")
  platformSatisfied           Boolean                      @default(false) @map("platform_satisfied")
  platformNotes               String?                      @map("platform_notes")
  // CTQ Transportation System Operator fields (027) -- only meaningful for division=SR profiles.
  // Quebec's Commission des transports du Québec requires an authorized operator to designate a
  // "répondant" (responsible contact) and a "répartiteur" (dispatcher), hold a compliant insurance
  // contract, and (once granted) carries a CTQ-issued authorization number -- mirrors the same
  // "operator-level fact, not per-driver" pattern citqRegistrationNumber uses at the per-listing
  // level for STR. All optional: filling these in is part of preparing the real CTQ-374 application,
  // not a claim that authorization already exists (status still gates everything, see
  // server/lib/jurisdiction-compliance.mjs).
  operatorRespondentName      String?                      @map("operator_respondent_name")
  operatorRespondentContact   String?                      @map("operator_respondent_contact")
  operatorDispatcherName      String?                      @map("operator_dispatcher_name")
  operatorDispatcherContact   String?                      @map("operator_dispatcher_contact")
  operatorInsuranceReference  String?                      @map("operator_insurance_reference")
  operatorAuthorizationNumber String?                      @map("operator_authorization_number")
  reviewedById                String?                      @map("reviewed_by_id")
  reviewedAt                  DateTime?                    @map("reviewed_at")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")

  reviewedBy User? @relation("JurisdictionComplianceReviewer", fields: [reviewedById], references: [id])

  @@unique([division, countryCode, regionCode])
  @@map("jurisdiction_compliance_profiles")
}

// ============ Québec/Canada tax-compliance foundation (029) ============
// Ride's progressive commission engine (028, server/lib/sr-payments.mjs) and Stay's flat 13%
// commission are UNCHANGED by this section -- statements below only ever READ the commission
// figures those engines already computed and stored, never recompute them.

enum TaxProfileSubjectType {
  DRIVER
  HOST

  @@map("tax_profile_subject_type")
}

enum TaxProfileBusinessType {
  INDIVIDUAL
  BUSINESS

  @@map("tax_profile_business_type")
}

enum TaxIdentifierType {
  SIN
  TIN
  OTHER

  @@map("tax_identifier_type")
}

enum GstQstTreatment {
  HOST_REGISTERED
  PLATFORM_COLLECTS

  @@map("gst_qst_treatment")
}

// One row per (user, DRIVER|HOST) -- a user who is both a driver and a host gets two rows, since
// the two roles have different regulatory obligations (e.g. GST/QST-before-first-Quebec-ride only
// applies to driving). SIN/TIN and the payout account identifier are the only fields encrypted at
// rest (server/lib/tax-encryption.mjs) -- GST/QST/NEQ numbers are business-registration numbers
// that Quebec businesses routinely disclose on invoices, not personal identifiers, so they're
// stored in plain text like every other business-registration field in this schema (e.g.
// JurisdictionComplianceProfile.operatorAuthorizationNumber).
model TaxProfile {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  subjectType TaxProfileSubjectType @map("subject_type")

  legalFirstName    String                 @map("legal_first_name")
  legalLastName     String                 @map("legal_last_name")
  legalBusinessName String?                @map("legal_business_name")
  businessType      TaxProfileBusinessType @default(INDIVIDUAL) @map("business_type")
  dateOfBirth       DateTime?              @map("date_of_birth")

  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  region       String
  postalCode   String  @map("postal_code")
  country      String

  taxResidenceCountry String  @map("tax_residence_country")
  taxResidenceRegion  String? @map("tax_residence_region")

  // Encrypted at rest; taxIdentifierLast4 is the ONLY plaintext fragment ever shown after initial
  // submission (see tax-encryption.mjs maskIdentifier / TaxProfile route's redacted serializer).
  taxIdentifierType       TaxIdentifierType @map("tax_identifier_type")
  taxIdentifierCiphertext String            @map("tax_identifier_ciphertext")
  taxIdentifierLast4      String            @map("tax_identifier_last4")

  gstRegistered Boolean @default(false) @map("gst_registered")
  gstNumber     String? @map("gst_number")
  qstRegistered Boolean @default(false) @map("qst_registered")
  qstNumber     String? @map("qst_number")
  neqNumber     String? @map("neq_number")

  payoutAccountCiphertext String? @map("payout_account_ciphertext")
  payoutAccountLast4      String? @map("payout_account_last4")

  // HOST only. Which GST/QST tax treatment applies (server/lib/quebec-stay-tax.mjs) -- NEVER
  // inferred; a host with gstRegistered=true still needs this explicitly decided (by them, or by
  // an admin on their behalf) with a recorded effective date and who/when decided it.
  gstQstTreatment            GstQstTreatment? @map("gst_qst_treatment")
  gstQstTreatmentEffectiveAt DateTime?        @map("gst_qst_treatment_effective_at")
  gstQstTreatmentDecidedById String?          @map("gst_qst_treatment_decided_by_id")
  gstQstTreatmentDecidedAt   DateTime?        @map("gst_qst_treatment_decided_at")

  consentRegulatoryReporting Boolean   @default(false) @map("consent_regulatory_reporting")
  certifiedAccurate          Boolean   @default(false) @map("certified_accurate")
  certifiedAccurateAt        DateTime? @map("certified_accurate_at")

  // Mirrors the existing idDocumentStatus/reviewedById/reviewedAt review pattern (User, DriverDocument).
  verificationStatus IdDocumentStatus @default(PENDING_REVIEW) @map("verification_status")
  verificationSource String?          @map("verification_source")
  verifiedAt         DateTime?        @map("verified_at")
  verifiedById       String?          @map("verified_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User  @relation("TaxProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("TaxProfileVerifier", fields: [verifiedById], references: [id])

  @@unique([userId, subjectType])
  @@map("tax_profiles")
}

enum PartXXActivityType {
  RIDE
  ACCOMMODATION

  @@map("part_xx_activity_type")
}

enum PartXXFilingStatus {
  DRAFT
  VALIDATED
  FILED
  ACCEPTED
  REJECTED
  CORRECTED

  @@map("part_xx_filing_status")
}

// One row per (seller, activity type, calendar year, quarter) -- the CRA Part XX reporting unit.
model PartXXRecord {
  id           String             @id @default(uuid())
  sellerId     String             @map("seller_id")
  activityType PartXXActivityType @map("activity_type")
  year         Int
  quarter      Int

  grossConsiderationMinor Int    @map("gross_consideration_minor")
  currency                String @default("USD")
  activityCount           Int    @map("activity_count")
  platformFeesMinor       Int    @map("platform_fees_minor")
  taxesWithheldMinor      Int    @default(0) @map("taxes_withheld_minor")
  refundsMinor            Int    @default(0) @map("refunds_minor")

  // ACCOMMODATION only.
  propertyAddress String? @map("property_address")

  status   PartXXFilingStatus @default(DRAFT)
  filingId String?            @map("filing_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller User          @relation("PartXXRecordSeller", fields: [sellerId], references: [id])
  filing PartXXFiling? @relation(fields: [filingId], references: [id])

  @@unique([sellerId, activityType, year, quarter])
  @@map("part_xx_records")
}

// One row per filing attempt/transmission for a given (year, quarter) batch. submittedXml is the
// immutable snapshot of exactly what was (or would be) reported -- never regenerated after the
// fact, so a later rule change can never silently rewrite what CRA actually received.
// correctionOfId deliberately has no Prisma relation (plain string, not enforced by a FK) to avoid
// self-relation ceremony for what is a rare, admin-driven pointer -- correctness is enforced at the
// route layer instead.
model PartXXFiling {
  id                  String             @id @default(uuid())
  year                Int
  quarter             Int
  status              PartXXFilingStatus @default(DRAFT)
  t619TransmissionRef String?            @map("t619_transmission_ref")
  submittedXml        String?            @map("submitted_xml")
  craResponse         Json?              @map("cra_response")
  submittedAt         DateTime?          @map("submitted_at")
  submittedById       String?            @map("submitted_by_id")
  acceptedAt          DateTime?          @map("accepted_at")
  errorDetails        Json?              @map("error_details")
  correctionOfId      String?            @map("correction_of_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  records PartXXRecord[]

  @@map("part_xx_filings")
}

// Explicit, admin-approved gates for regulatory behavior that must never silently activate --
// e.g. Revenu Québec RSE remittance, or platform collection of GST/QST from non-registered hosts.
// Defaults to disabled; enabling requires approvedById + approvedAt to be set together (enforced at
// the route layer, server/lib/compliance-feature-flags.mjs), so "enabled" always has a named human
// and a timestamp behind it.
model ComplianceFeatureFlag {
  id           String    @id @default(uuid())
  key          String    @unique
  enabled      Boolean   @default(false)
  note         String?
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("compliance_feature_flags")
}

// ============ Jurisdiction-based pricing engine (030) ============
// The centerpiece the tax/pricing correction asked for: no more one hardcoded Canadian rate for
// every province. Every tax and commission figure this platform charges is either a real, tested
// existing constant (kept as the seed/fallback default -- e.g. SR_COMMISSION_TIERS,
// quebec-stay-tax.mjs's rates) or a row in one of these two tables, resolved by
// server/lib/jurisdiction-pricing.mjs for (country, province, municipality, serviceType, asOf).
// A jurisdiction's rows are inert (never applied) until `active` is explicitly set -- "do not
// activate a province or municipality until its compliance configuration has been legally
// reviewed" is enforced here, not left to convention.

enum JurisdictionServiceType {
  RIDE
  STAY

  @@map("jurisdiction_service_type")
}

enum JurisdictionTaxType {
  GST
  QST
  LODGING
  REGULATORY_CONTRIBUTION

  @@map("jurisdiction_tax_type")
}

enum JurisdictionCalculationBase {
  ACCOMMODATION_ONLY
  FARE_BASE
  TOTAL_BOOKING

  @@map("jurisdiction_calculation_base")
}

enum JurisdictionCollectorType {
  PLATFORM
  HOST_OR_DRIVER
  DEPENDS_ON_REGISTRATION

  @@map("jurisdiction_collector_type")
}

// Rate is stored as an exact integer, parts-per-million (1% = 10,000 parts) -- never a float --
// so Quebec's real 9.975% QST rate (997,500 parts) has no rounding ambiguity in storage. The one
// float multiplication this ever goes through (rate/1,000,000 * amountMinor, then Math.round) is
// the same single-step pattern already used and tested throughout this codebase's money math
// (e.g. quebec-stay-tax.mjs) -- full arbitrary-precision decimal arithmetic would be a materially
// larger undertaking than this correction calls for.
model JurisdictionTaxRate {
  id              String                      @id @default(uuid())
  country         String
  province        String?
  municipality    String?
  serviceType     JurisdictionServiceType     @map("service_type")
  taxType         JurisdictionTaxType         @map("tax_type")
  rateParts       Int                         @map("rate_parts")
  calculationBase JurisdictionCalculationBase @map("calculation_base")
  collectorType   JurisdictionCollectorType   @map("collector_type")
  roundingRule    String                      @default("ROUND_HALF_UP") @map("rounding_rule")

  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  // Fails closed: a row is never applied by the resolver while active=false, regardless of dates.
  active              Boolean   @default(false)
  legallyReviewedById String?   @map("legally_reviewed_by_id")
  legallyReviewedAt   DateTime? @map("legally_reviewed_at")
  sourceUrl           String?   @map("source_url")
  note                String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([country, province, municipality, serviceType, taxType, effectiveFrom])
  @@map("jurisdiction_tax_rates")
}

// Commission policy per jurisdiction -- FLAT (Stay's 13%) or PROGRESSIVE (Ride's 12/11/10/9%
// tiers, stored as JSON matching sr-payments.mjs's SR_COMMISSION_TIERS shape exactly). country/
// province null = the global default (what every existing driver/host is charged today); a
// province-specific row, once active, overrides the global default for that province only.
model JurisdictionCommissionPolicy {
  id            String                  @id @default(uuid())
  country       String?
  province      String?
  serviceType   JurisdictionServiceType @map("service_type")
  policyType    String                  @map("policy_type") // 'FLAT' | 'PROGRESSIVE'
  flatRateParts Int?                    @map("flat_rate_parts")
  tiers         Json?

  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  active              Boolean   @default(false)
  legallyReviewedById String?   @map("legally_reviewed_by_id")
  legallyReviewedAt   DateTime? @map("legally_reviewed_at")
  note                String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([country, province, serviceType, effectiveFrom])
  @@map("jurisdiction_commission_policies")
}

// Immutable pricing snapshot (030): exactly which jurisdiction rows (or fallback defaults) and
// computed figures applied to one quote/booking/ride at the moment it was priced. Never
// recomputed or edited after creation -- a later rate change, a jurisdiction going active, or an
// admin editing a JurisdictionTaxRate row can never retroactively alter what a past subject was
// actually charged. subjectType+subjectId is a loose reference (ride id, booking id, or a
// pre-booking quote token) rather than a typed FK, since a quote often has no booking row yet.
model PricingSnapshot {
  id          String   @id @default(uuid())
  subjectType String   @map("subject_type") // 'SR_QUOTE' | 'SR_RIDE' | 'STR_BOOKING'
  subjectId   String   @map("subject_id")
  country     String
  province    String?
  breakdown   Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([subjectType, subjectId])
  @@map("pricing_snapshots")
}

// ============ SR safety layer (014) ============
enum SosRole {
  RIDER
  DRIVER

  @@map("sos_role")
}

enum SosStatus {
  OPEN
  RESOLVED

  @@map("sos_status")
}

model SosEvent {
  id             String    @id @default(uuid())
  rideId         String    @map("ride_id")
  raisedByUserId String    @map("raised_by_user_id")
  raisedByRole   SosRole   @map("raised_by_role")
  lat            Float?
  lng            Float?
  note           String?
  status         SosStatus @default(OPEN)
  resolvedById   String?   @map("resolved_by_id")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  ride       RideRequest @relation(fields: [rideId], references: [id], onDelete: Cascade)
  raisedBy   User        @relation("SosRaisedBy", fields: [raisedByUserId], references: [id])
  resolvedBy User?       @relation("SosResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([rideId])
  @@map("sos_events")
}

// ============ SR trust layer (015) ============
enum DriverDocumentType {
  LICENSE
  VEHICLE_REGISTRATION
  INSURANCE
  // Quebec SAAQ requirements (028) -- only meaningful once a driver's DriverProfile.country is 'CA'.
  // SAAQ_AUTHORIZED_DRIVER_PERMIT: the SAAQ "authorized driver" certificate (individual path, Class 5
  // license >=12mo, French proficiency, training + test). CRIMINAL_RECORD_CHECK: the municipal
  // police / Sûreté du Québec certificate SAAQ requires (RCMP or private-firm checks don't qualify).
  SAAQ_AUTHORIZED_DRIVER_PERMIT
  CRIMINAL_RECORD_CHECK

  @@map("driver_document_type")
}

enum RideParticipantRole {
  RIDER
  DRIVER

  @@map("ride_participant_role")
}

model DriverDocument {
  id           String             @id @default(uuid())
  driverUserId String             @map("driver_user_id")
  type         DriverDocumentType
  assetUrl     String             @map("asset_url")
  mimeType     String?            @map("mime_type")
  status       IdDocumentStatus   @default(PENDING_REVIEW)
  reviewedById String?            @map("reviewed_by_id")
  reviewedAt   DateTime?          @map("reviewed_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  driver   User  @relation("DriverDocumentOwner", fields: [driverUserId], references: [id], onDelete: Cascade)
  reviewer User? @relation("DriverDocumentReviewer", fields: [reviewedById], references: [id])

  @@unique([driverUserId, type])
  @@index([status])
  @@map("driver_documents")
}

enum ListingDocumentType {
  // Québec accommodation-platform requirement: a self-attested expiry-date field is not sufficient
  // -- the platform must hold the host's actual registration certificate and have an admin review it
  // before the listing may go live or take bookings. See ListingDocument for the retention and
  // verification-status design (second compliance-review correction pass).
  CITQ_CERTIFICATE

  @@map("listing_document_type")
}

// Second correction pass: manual admin review is real, but it is NOT the same thing as a legally
// definitive "verified" status -- the digital certificate has its own authenticity mechanism this
// platform doesn't check yet. PENDING_REVIEW/REJECTED are unchanged. ADMIN_REVIEWED_TEST replaces
// what used to be called APPROVED -- an admin looked at it, in test mode, nothing more claimed.
// EXPIRED is set once the certificate's own expiry date has passed (see markExpiredListingDocuments
// in listing-document-retention.mjs). DIGITAL_VERIFICATION_PENDING/DIGITALLY_VERIFIED are reserved
// for a future real verification integration -- no code path sets DIGITALLY_VERIFIED today.
enum ListingDocumentStatus {
  PENDING_REVIEW
  ADMIN_REVIEWED_TEST
  REJECTED
  EXPIRED
  DIGITAL_VERIFICATION_PENDING
  DIGITALLY_VERIFIED

  @@map("listing_document_status")
}

// Real certificate files (not just a free-text registration number + expiry date) for per-listing
// regulatory documents. Same handling as DriverDocument: real bytes written to a private,
// non-web-servable directory keyed by a random id, served only through an authz-gated endpoint.
// Retention (second compliance-review correction pass): a certificate is retained until one year
// after ITS OWN expiry (retentionDeleteAfter, computed from expiresAt at upload time), then queued
// for secure deletion by listing-document-retention.mjs's purge job -- unless legalHold is set, which
// blocks deletion indefinitely and must carry a reason and a recording admin. Deletion removes the
// file from disk and clears assetUrl/mimeType on this row (deletedAt stamped), but the row itself and
// an AdminAuditLog entry survive as the audit record -- "preserve a record of deletion without
// retaining the certificate itself."
model ListingDocument {
  id                   String                @id @default(uuid())
  listingId            String                @map("listing_id")
  type                 ListingDocumentType
  // Third compliance-review correction pass: a legal hold must preserve the held certificate AND
  // its audit trail while still letting the host upload a newer renewal -- it must never block
  // re-upload outright. version/isCurrent/replacesId turn this into an append-only chain: the held
  // row is never mutated by a new upload, a fresh row is inserted with isCurrent = true and
  // replacesId pointing back at the previous row, and the previous row's isCurrent flips to false.
  // "Current" is always the single isCurrent = true row per (listingId, type); enforced in
  // application code inside a transaction (server/routes/listings.mjs), not by a DB constraint.
  version              Int                   @default(1)
  isCurrent            Boolean               @default(true) @map("is_current")
  replacesId           String?               @unique @map("replaces_id")
  assetUrl             String?               @map("asset_url")
  mimeType             String?               @map("mime_type")
  status               ListingDocumentStatus @default(PENDING_REVIEW)
  reviewedById         String?               @map("reviewed_by_id")
  reviewedAt           DateTime?             @map("reviewed_at")
  expiresAt            DateTime?             @map("expires_at")
  retentionDeleteAfter DateTime?             @map("retention_delete_after")
  legalHold            Boolean               @default(false) @map("legal_hold")
  legalHoldReason      String?               @map("legal_hold_reason")
  legalHoldSetById     String?               @map("legal_hold_set_by_id")
  legalHoldSetAt       DateTime?             @map("legal_hold_set_at")
  deletedAt            DateTime?             @map("deleted_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  listing        Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer       User?            @relation("ListingDocumentReviewer", fields: [reviewedById], references: [id])
  legalHoldSetBy User?            @relation("ListingDocumentLegalHoldSetBy", fields: [legalHoldSetById], references: [id])
  replaces       ListingDocument? @relation("ListingDocumentReplaces", fields: [replacesId], references: [id])
  replacedBy     ListingDocument? @relation("ListingDocumentReplaces")

  @@unique([listingId, type, version])
  @@index([listingId, type, isCurrent])
  @@index([status])
  @@index([retentionDeleteAfter])
  @@map("listing_documents")
}

model RideMessage {
  id           String              @id @default(uuid())
  rideId       String              @map("ride_id")
  senderUserId String              @map("sender_user_id")
  senderRole   RideParticipantRole @map("sender_role")
  body         String
  createdAt    DateTime            @default(now()) @map("created_at")

  ride   RideRequest @relation(fields: [rideId], references: [id], onDelete: Cascade)
  sender User        @relation("RideMessageSender", fields: [senderUserId], references: [id])

  @@index([rideId, createdAt])
  @@map("ride_messages")
}

model RideRating {
  id          String              @id @default(uuid())
  rideId      String              @map("ride_id")
  raterUserId String              @map("rater_user_id")
  ratedUserId String              @map("rated_user_id")
  raterRole   RideParticipantRole @map("rater_role")
  stars       Int
  safetyFlag  Boolean             @default(false) @map("safety_flag")
  comment     String?
  createdAt   DateTime            @default(now()) @map("created_at")

  ride  RideRequest @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rater User        @relation("RideRatingRater", fields: [raterUserId], references: [id])
  rated User        @relation("RideRatingRated", fields: [ratedUserId], references: [id])

  @@unique([rideId, raterUserId])
  @@index([ratedUserId, safetyFlag])
  @@index([raterUserId, safetyFlag])
  @@map("ride_ratings")
}

// SR cancellation accountability (019): one row per driver-initiated cancellation. Feeds the driver's
// cancellation count (admin visibility) and blocks the cancelling driver from re-claiming that same ride.
model DriverCancellation {
  id        String   @id @default(uuid())
  rideId    String   @map("ride_id")
  driverId  String   @map("driver_id")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  ride   RideRequest @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver User        @relation("DriverCancellationDriver", fields: [driverId], references: [id])

  @@index([driverId])
  @@index([rideId])
  @@map("driver_cancellations")
}

// SR fleet (020): a driver's registered vehicle record. Carries the model year, which the age gate
// enforces per ride tier (standard/Economy ≤ 10 years, premium tiers newer — see server/lib/fleet.mjs).
// Admin-reviewed before it can be used. A driver may register more than one vehicle.
model DriverVehicle {
  id           String           @id @default(uuid())
  driverId     String           @map("driver_id")
  make         String
  model        String
  year         Int
  plate        String
  color        String?
  category     String // 'SR Economy' | 'SR Comfort' | 'SR SUV'
  // Jurisdiction compliance (028): which market's vehicle-eligibility rules apply (server/lib/
  // fleet.mjs). Quebec's SAAQ rules (uniform <=10yr age, wheelbase, weight, seats) differ from
  // Syria's tiered age limits -- see assertVehicleEligible.
  country      String           @default("SY")
  status       IdDocumentStatus @default(PENDING_REVIEW)
  reviewedById String?          @map("reviewed_by_id")
  reviewedAt   DateTime?        @map("reviewed_at")
  reviewNote   String?          @map("review_note")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  driver           User                     @relation("DriverVehicleOwner", fields: [driverId], references: [id])
  quebecOnboarding QuebecVehicleOnboarding?

  @@index([driverId, status])
  @@map("driver_vehicles")
}

enum DisputeStatus {
  OPEN
  RESOLVED_REFUNDED
  RESOLVED_REJECTED

  @@map("dispute_status")
}

// Consumer-protection dispute/refund (021): a customer opens a dispute on a completed SR ride or STR
// booking within the country's dispute window; an admin adjudicates and either refunds (idempotent
// wallet credit, capped at the amount paid) or rejects with a logged reason. The ride/booking link is
// SetNull so the dispute record survives for audit even if the underlying row is later removed.
model Dispute {
  id             String        @id @default(uuid())
  subjectType    String        @map("subject_type") // 'SR_RIDE' | 'STR_BOOKING'
  rideId         String?       @map("ride_id")
  bookingId      String?       @map("booking_id")
  openedByUserId String        @map("opened_by_user_id")
  reason         String
  status         DisputeStatus @default(OPEN)
  refundMinor    Int?          @map("refund_minor")
  currency       String?
  resolutionNote String?       @map("resolution_note")
  resolvedById   String?       @map("resolved_by_id")
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  ride     RideRequest? @relation(fields: [rideId], references: [id], onDelete: SetNull)
  booking  Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  openedBy User         @relation("DisputeOpener", fields: [openedByUserId], references: [id])

  @@index([status])
  @@index([openedByUserId])
  @@map("disputes")
}

// ============================================================================
// SR Intercity service module (023) — DORMANT SCHEMA ONLY. Tables for garages,
// routes, variable route tariffs, operators, formable service trips and seat
// bookings, so the SR v2 Intercity module lands additively later (never a
// migration against live bookings). No endpoints, no wiring — behavior comes in
// the v2 build. Cross-module refs (rider/driver/creator user ids, vehicle id)
// are kept as PLAIN SCALAR ids on purpose so this dormant add-on does not touch
// User's / DriverVehicle's relation blocks; real relations arrive with v2.
// ============================================================================

enum OperatorType {
  BUS_COMPANY
  TAXI_FLEET

  @@map("operator_type")
}

enum ServiceTripStatus {
  FORMING
  READY
  DEPARTED
  COMPLETED
  CANCELLED

  @@map("service_trip_status")
}

enum SeatBookingStatus {
  RESERVED
  PAID
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("seat_booking_status")
}

enum DepartureMode {
  FILL_AND_GO
  SCHEDULED

  @@map("departure_mode")
}

enum TariffScope {
  ROUTE
  OPERATOR
  GLOBAL

  @@map("tariff_scope")
}

enum TariffReason {
  HOLIDAY
  HIGH_SEASON
  EVENT
  FUEL
  MANUAL

  @@map("tariff_reason")
}

enum TariffKind {
  MULTIPLIER
  ABSOLUTE

  @@map("tariff_kind")
}

// A physical intercity pickup/drop point (bus station, taxi garage) in a city.
model Garage {
  id        String   @id @default(uuid())
  country   String
  city      String
  name      String
  lat       Float?
  lng       Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Two distinct relations to Route (origin + destination) — named on both sides so Prisma can tell
  // them apart. Each named relation MUST appear exactly twice (once here, once on Route).
  originRoutes Route[] @relation("RouteOrigin")
  destRoutes   Route[] @relation("RouteDest")

  @@index([country, city])
  @@map("garages")
}

// A directed intercity route between two garages.
model Route {
  id             String   @id @default(uuid())
  originGarageId String   @map("origin_garage_id")
  destGarageId   String   @map("dest_garage_id")
  distanceKm     Int?     @map("distance_km")
  estMinutes     Int?     @map("est_minutes")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  originGarage      Garage             @relation("RouteOrigin", fields: [originGarageId], references: [id])
  destGarage        Garage             @relation("RouteDest", fields: [destGarageId], references: [id])
  tariffs           RouteTariff[]
  trips             ServiceTrip[]
  tariffAdjustments TariffAdjustment[]

  @@index([originGarageId])
  @@index([destGarageId])
  @@map("routes")
}

// Base per-tier price for a route: per-seat and whole-vehicle (private hire) amounts.
model RouteTariff {
  id                String   @id @default(uuid())
  routeId           String   @map("route_id")
  tier              String
  perSeatMinor      Int      @map("per_seat_minor")
  wholeVehicleMinor Int      @map("whole_vehicle_minor")
  currency          String   @default("USD")
  locked            Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, tier])
  @@map("route_tariffs")
}

// Dated holiday/season/event price overrides. `value` is a basis-points multiplier when kind =
// MULTIPLIER (10000 = 1.0x), or a minor amount when kind = ABSOLUTE.
model TariffAdjustment {
  id              String       @id @default(uuid())
  scope           TariffScope
  routeId         String?      @map("route_id")
  operatorId      String?      @map("operator_id")
  tier            String?
  effectiveFrom   DateTime     @map("effective_from")
  effectiveTo     DateTime     @map("effective_to")
  reason          TariffReason
  kind            TariffKind
  value           Int
  priority        Int          @default(0)
  createdByUserId String       @map("created_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  route    Route?    @relation(fields: [routeId], references: [id], onDelete: SetNull)
  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([routeId])
  @@index([operatorId])
  @@index([effectiveFrom, effectiveTo])
  @@map("tariff_adjustments")
}

// A bus company or taxi fleet that runs service trips.
model Operator {
  id           String       @id @default(uuid())
  name         String
  type         OperatorType
  country      String
  contactPhone String?      @map("contact_phone")
  status       String       @default("PENDING")
  verified     Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  trips             ServiceTrip[]
  tariffAdjustments TariffAdjustment[]

  @@index([country, status])
  @@map("operators")
}

// A forming/scheduled trip on a route: fills seats (FILL_AND_GO) or departs on a schedule (SCHEDULED).
// driverUserId / vehicleId / operatorId are scalar refs for now (see module header).
model ServiceTrip {
  id                String            @id @default(uuid())
  routeId           String            @map("route_id")
  tier              String
  operatorId        String?           @map("operator_id")
  driverUserId      String?           @map("driver_user_id")
  vehicleId         String?           @map("vehicle_id")
  capacity          Int
  seatsAvailable    Int               @map("seats_available")
  seatMap           Json?             @map("seat_map")
  status            ServiceTripStatus @default(FORMING)
  departureMode     DepartureMode     @map("departure_mode")
  scheduledDepartAt DateTime?         @map("scheduled_depart_at")
  departedAt        DateTime?         @map("departed_at")
  perSeatMinor      Int               @map("per_seat_minor")
  currency          String            @default("USD")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  route        Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  operator     Operator?     @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  seatBookings SeatBooking[]

  @@index([routeId, status])
  @@index([operatorId])
  @@map("service_trips")
}

// A rider's seat(s) on a service trip. ticketCode is globally unique (the boarding ticket).
model SeatBooking {
  id            String            @id @default(uuid())
  serviceTripId String            @map("service_trip_id")
  riderUserId   String            @map("rider_user_id")
  seatCount     Int               @default(1) @map("seat_count")
  seatLabels    String[]          @map("seat_labels")
  amountMinor   Int               @map("amount_minor")
  currency      String            @default("USD")
  ticketCode    String            @unique @map("ticket_code")
  status        SeatBookingStatus @default(RESERVED)
  boardedAt     DateTime?         @map("boarded_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  serviceTrip ServiceTrip @relation(fields: [serviceTripId], references: [id], onDelete: Cascade)

  @@index([serviceTripId])
  @@index([riderUserId])
  @@map("seat_bookings")
}

// ============================================================================
// Store-readiness UGC safety (024) — user reports + user blocks. Required by
// Apple 1.2 / Google UGC policy: users must be able to report content and block
// other users. Subject/user references are plain scalar ids (no User relation)
// so this addition doesn't touch User's relation block.
// ============================================================================

enum ReportSubjectType {
  LISTING
  REVIEW
  SELLER
  USER
  RIDE
  BOOKING

  @@map("report_subject_type")
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED

  @@map("report_status")
}

// A user-filed report against a piece of user-generated content or another user. Admin-triaged.
model Report {
  id             String            @id @default(uuid())
  reporterUserId String            @map("reporter_user_id")
  subjectType    ReportSubjectType @map("subject_type")
  subjectId      String            @map("subject_id")
  reason         String
  note           String?
  status         ReportStatus      @default(OPEN)
  resolutionNote String?           @map("resolution_note")
  resolvedById   String?           @map("resolved_by_id")
  resolvedAt     DateTime?         @map("resolved_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([subjectType, subjectId])
  @@index([reporterUserId])
  @@map("reports")
}

// A directional block: blockerUserId will never be SR-matched with, nor able to message, blockedUserId
// (enforcement checks both directions). Unique on the ordered pair.
model UserBlock {
  id            String   @id @default(uuid())
  blockerUserId String   @map("blocker_user_id")
  blockedUserId String   @map("blocked_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}
