// Cross-instance rate-limit counter (fixed window). Used only when RATE_LIMIT_STORE=db (serverless /
// multi-instance), so the per-endpoint limits hold across all API instances instead of resetting per
// process. One row per (rule, bucket-key); the reset window is stored on the row and refreshed
// atomically on each hit. In-memory is still the default for local/dev and the unit tests.
model RateLimitHit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limit_hits")
}

