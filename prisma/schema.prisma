generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
  CLOSED

  @@map("account_status")
}

enum RoleName {
  GUEST
  HOST
  SELLER
  DRIVER
  ADMIN
  SUPPORT

  @@map("role_name")
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  EXPIRED

  @@map("listing_status")
}

enum IdDocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("id_document_status")
}

enum AvailabilityStatus {
  BLOCKED
  AVAILABLE

  @@map("availability_status")
}

enum ListingDivision {
  STAYS
  RENTALS
  BUY
  CARS
  MARKETPLACE
  NEW_CONSTRUCTION

  @@map("listing_division")
}

enum BookingStatus {
  DRAFT
  REQUESTED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  DISPUTED

  @@map("booking_status")
}

enum PaymentStatus {
  PENDING_PROOF
  PENDING_ADMIN_REVIEW
  APPROVED
  REJECTED
  REFUNDED

  @@map("payment_status")
}

enum WalletEntryType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND

  @@map("wallet_entry_type")
}

enum GiftStatus {
  CREATED
  SENT
  CLAIM_PENDING
  CLAIMED
  LOCKED
  EXPIRED
  ADMIN_BLOCKED

  @@map("gift_status")
}

enum RideStatus {
  DRAFT
  REQUESTED
  MATCHING
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("ride_status")
}

enum MessageSenderRole {
  GUEST
  HOST
  ADMIN
  SUPPORT

  @@map("message_sender_role")
}

model User {
  id                     String            @id @default(uuid())
  email                  String?           @unique
  phoneHash              String?           @unique @map("phone_hash")
  passwordHash           String?           @map("password_hash")
  displayName            String            @map("display_name")
  locale                 String            @default("ar-SY")
  status                 AccountStatus     @default(ACTIVE)
  idDocumentRef          String?           @map("id_document_ref")
  idDocumentSubmittedAt  DateTime?         @map("id_document_submitted_at")
  idDocumentMimeType     String?           @map("id_document_mime_type")
  idDocumentStatus       IdDocumentStatus? @map("id_document_status")
  idDocumentReviewedById String?           @map("id_document_reviewed_by_id")
  idDocumentReviewedAt   DateTime?         @map("id_document_reviewed_at")
  // How this user is paid out (host stay payouts / seller payouts). Free-form JSON, e.g.
  // { type: 'sham_cash', phone, receiverName }. Surfaced ONLY to admin payout reminders
  // (see routes/admin.mjs /api/admin/payouts) — never to guests or hosts of other accounts.
  payoutMethod           Json?             @map("payout_method")
  // Bumped on logout and on password reset; embedded as a claim in every session token and
  // checked on every request (server/lib/auth-context.mjs). A stateless HMAC-signed token has no
  // other way to be revoked before its 7-day expiry -- this is the whole mechanism (security audit
  // finding F-02).
  sessionVersion         Int               @default(0) @map("session_version")
  // Shareable referral code, generated once at account creation (server/lib/referrals.mjs). Every
  // user has one, whether or not they ever refer anyone -- generated lazily would need a
  // read-then-write race guard for no benefit, since it's nearly free to always have one.
  referralCode           String            @unique @map("referral_code")
  // Store-readiness (024): in-app account deletion anonymizes the row and stamps deletedAt / status=CLOSED
  // rather than hard-deleting it, so wallet-ledger + audit references survive against an anonymized subject.
  deletedAt              DateTime?         @map("deleted_at")
  // Reviewer demo accounts (024): App Store / Play reviewers log into these pre-verified accounts. Flagged
  // so they can be recognized (and excluded from real metrics); they carry no admin role.
  isDemo                 Boolean           @default(false) @map("is_demo")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  roles                              UserRole[]
  sellerProfile                      SellerProfile?
  driverProfile                      DriverProfile?
  listings                           Listing[]                       @relation("ListingOwner")
  bookings                           Booking[]                       @relation("BookingGuest")
  wallets                            Wallet[]
  sentGifts                          WalletGift[]                    @relation("GiftSender")
  claimedGifts                       WalletGift[]                    @relation("GiftRecipient")
  rideRequests                       RideRequest[]                   @relation("RideRider")
  driverRideMatches                  RideRequest[]                   @relation("RideDriver")
  auditLogs                          AdminAuditLog[]                 @relation("AuditActor")
  listingReviews                     ListingReview[]                 @relation("ReviewGuest")
  sentMessages                       Message[]                       @relation("MessageSender")
  paymentProofs                      PaymentProof[]                  @relation("PaymentPayer")
  listingInquiries                   MessageThread[]                 @relation("ListingInquiryGuest")
  accommodations                     Accommodation[]                 @relation("AccommodationOwner")
  hostInsights                       HostInsight[]                   @relation("HostInsightOwner")
  referralsMade                      Referral[]                      @relation("ReferralReferrer")
  referredAs                         Referral?                       @relation("ReferralReferee")
  // SR safety/trust layers (014/015)
  sosEventsRaised                    SosEvent[]                      @relation("SosRaisedBy")
  sosEventsResolved                  SosEvent[]                      @relation("SosResolvedBy")
  driverDocuments                    DriverDocument[]                @relation("DriverDocumentOwner")
  driverDocumentsReviewed            DriverDocument[]                @relation("DriverDocumentReviewer")
  listingDocumentsReviewed           ListingDocument[]               @relation("ListingDocumentReviewer")
  listingDocumentLegalHoldsSet       ListingDocument[]               @relation("ListingDocumentLegalHoldSetBy")
  quebecDriverOnboardingsReviewed    QuebecDriverOnboarding[]        @relation("QuebecDriverOnboardingReviewer")
  quebecDriverOnboardingsAssigned    QuebecDriverOnboarding[]        @relation("QuebecDriverOnboardingAssignedReviewer")
  quebecVehicleOnboardingsReviewed   QuebecVehicleOnboarding[]       @relation("QuebecVehicleOnboardingReviewer")
  quebecVehicleOnboardingsAssigned   QuebecVehicleOnboarding[]       @relation("QuebecVehicleOnboardingAssignedReviewer")
  quebecDriverDocumentsReviewed      QuebecDriverDocument[]          @relation("QuebecDriverDocumentReviewer")
  quebecDriverDocumentLegalHoldsSet  QuebecDriverDocument[]          @relation("QuebecDriverDocumentLegalHoldSetBy")
  quebecVehicleDocumentsReviewed     QuebecVehicleDocument[]         @relation("QuebecVehicleDocumentReviewer")
  quebecVehicleDocumentLegalHoldsSet QuebecVehicleDocument[]         @relation("QuebecVehicleDocumentLegalHoldSetBy")
  rideMessagesSent                   RideMessage[]                   @relation("RideMessageSender")
  rideRatingsGiven                   RideRating[]                    @relation("RideRatingRater")
  rideRatingsReceived                RideRating[]                    @relation("RideRatingRated")
  sellerSalesMade                    SellerSale[]                    @relation("SellerSaleSeller")
  sellerPurchases                    SellerSale[]                    @relation("SellerSaleBuyer")
  sellerReviewsReceived              SellerReview[]                  @relation("SellerReviewSeller")
  sellerReviewsWritten               SellerReview[]                  @relation("SellerReviewBuyer")
  driverCancellations                DriverCancellation[]            @relation("DriverCancellationDriver")
  driverVehicles                     DriverVehicle[]                 @relation("DriverVehicleOwner")
  disputesOpened                     Dispute[]                       @relation("DisputeOpener")
  threadDocumentsUploaded            ThreadDocument[]                @relation("ThreadDocumentUploader")
  jurisdictionProfilesReviewed       JurisdictionComplianceProfile[] @relation("JurisdictionComplianceReviewer")
  taxProfiles                        TaxProfile[]                    @relation("TaxProfileOwner")
  taxProfilesVerified                TaxProfile[]                    @relation("TaxProfileVerifier")
  partXXRecords                      PartXXRecord[]                  @relation("PartXXRecordSeller")
  payoutsReceived                    Payout[]                        @relation("PayoutHost")

  @@map("users")
}

enum ReferralStatus {
  PENDING
  REWARDED

  @@map("referral_status")
}

// Double-sided referral program (riders/hosts/drivers bring new users, both sides get rewarded --
// same "give X, get Y" shape as Lyft/Uber's referral programs). The referee's signup bonus is
// credited immediately at registration (server/routes/auth.mjs); the referrer's reward is only
// credited once the referee completes their first *paid* STR booking (server/lib/referrals.mjs),
// not merely on signup -- otherwise this would be trivially farmable with throwaway accounts that
// never generate any real revenue.
model Referral {
  id                  String         @id @default(uuid())
  referrerUserId      String         @map("referrer_user_id")
  refereeUserId       String         @unique @map("referee_user_id")
  status              ReferralStatus @default(PENDING)
  qualifyingBookingId String?        @map("qualifying_booking_id")
  rewardedAt          DateTime?      @map("rewarded_at")
  createdAt           DateTime       @default(now()) @map("created_at")

  referrer User @relation("ReferralReferrer", fields: [referrerUserId], references: [id])
  referee  User @relation("ReferralReferee", fields: [refereeUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId, status])
  @@map("referrals")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      RoleName
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model SellerProfile {
  id             String        @id @default(uuid())
  userId         String        @unique @map("user_id")
  legalName      String        @map("legal_name")
  sellerType     String        @map("seller_type")
  documentStatus ListingStatus @default(DRAFT) @map("document_status")
  planCode       String?       @map("plan_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model DriverProfile {
  id               String                               @id @default(uuid())
  userId           String                               @unique @map("user_id")
  licenseHash      String?                              @map("license_hash")
  vehicleMake      String?                              @map("vehicle_make")
  vehicleModel     String?                              @map("vehicle_model")
  vehiclePlate     String?                              @map("vehicle_plate")
  // Jurisdiction compliance (028): which market's rules apply to this driver's documents/vehicle
  // eligibility. Does NOT by itself enable ride-matching there -- SR/SIR ride creation and location
  // pings stay geofenced to Syria (assertSyriaCoords) until the real CTQ/SAAQ authorization exists
  // and the market's JurisdictionComplianceProfile is flipped to APPROVED (server/lib/
  // jurisdiction-compliance.mjs). This only lets a Quebec-based driver's documents/vehicle be
  // reviewed against the correct (SAAQ) rules ahead of that.
  country          String                               @default("SY")
  active           Boolean                              @default(false)
  lastLocationGeo  Unsupported("geometry(Point,4326)")? @map("last_location_geo")
  // SR money model (016): where the driver's SR earnings are paid out (Sham Cash).
  payoutMethod     String?                              @map("payout_method")
  payoutAccountRef String?                              @map("payout_account_ref")
  createdAt        DateTime                             @default(now()) @map("created_at")
  updatedAt        DateTime                             @updatedAt @map("updated_at")

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quebecOnboarding QuebecDriverOnboarding?

  @@map("driver_profiles")
}

// Québec driver/vehicle onboarding (Phase 1: data model + API foundation). This is deliberately a
// NEW, additive, parallel system -- it does not touch DriverProfile.active or DriverVehicle.status,
// which stay exactly as they are for the live Syria SR flow. A driver cannot reach ACTIVE here
// unless the Québec ride-hailing jurisdiction (SR/CA/quebec in JurisdictionComplianceProfile) is
// itself APPROVED (assertQuebecRideJurisdictionApproved in quebec-driver-onboarding.mjs) -- the same
// "market approval gates individual approval" discipline used everywhere else in this codebase.
// Nothing here enables a real paid ride: SR ride creation/location pings stay hard-geofenced to
// Syria (assertSyriaCoords) regardless of this model's status.
enum QuebecDriverOnboardingStatus {
  DRAFT
  IDENTITY_PENDING
  DRIVER_DOCUMENTS_PENDING
  POLICE_CHECK_PENDING
  TRAINING_PENDING
  TAX_REGISTRATION_PENDING
  VEHICLE_PENDING
  INSURANCE_PENDING
  ADMIN_REVIEW
  APPROVED_INACTIVE
  ACTIVE
  SUSPENDED
  EXPIRED
  REJECTED

  @@map("quebec_driver_onboarding_status")
}

enum QuebecVehicleOnboardingStatus {
  DRAFT
  DOCUMENTS_PENDING
  INSPECTION_PENDING
  ADMIN_REVIEW
  APPROVED_INACTIVE
  ACTIVE
  EXPIRED
  SUSPENDED
  REJECTED

  @@map("quebec_vehicle_onboarding_status")
}

// Shared status for the individual regulatory line-items that make up a driver's compliance profile
// (GST registration, QST registration, the Revenu Québec operator file, SEV/SRS ride-hailing
// registration). Deliberately mirrors ListingDocumentStatus's discipline: ADMIN_REVIEWED_TEST is a
// human having looked at self-reported/uploaded evidence in test mode, never a legal "verified" claim.
enum QuebecComplianceItemStatus {
  NOT_STARTED
  SUBMITTED
  ADMIN_REVIEWED_TEST
  REJECTED

  @@map("quebec_compliance_item_status")
}

// No malware-scanning integration exists in this codebase. Every uploaded file stays PENDING
// (never CLEAN) so nothing ever implies a scan happened that didn't -- see the explicit instruction
// in quebec-document-storage.mjs. QUARANTINED/NOT_IMPLEMENTED/CLEAN are modeled now so a future real
// scanner integration has somewhere to write its result without another migration.
enum MalwareScanStatus {
  PENDING
  QUARANTINED
  NOT_IMPLEMENTED
  CLEAN

  @@map("malware_scan_status")
}

enum QuebecDriverDocumentType {
  DRIVERS_LICENSE
  DRIVING_RECORD_ABSTRACT
  POLICE_BACKGROUND_CHECK
  SAAQ_AUTHORIZED_DRIVER_PERMIT
  PROOF_OF_TRAINING_COMPLETION
  FRENCH_LANGUAGE_ATTESTATION
  GST_REGISTRATION
  QST_REGISTRATION
  REVENU_QUEBEC_OPERATOR_FILE
  PROOF_OF_IDENTITY
  PROOF_OF_ADDRESS

  @@map("quebec_driver_document_type")
}

enum QuebecVehicleDocumentType {
  VEHICLE_REGISTRATION
  PROOF_OF_INSURANCE
  SAAQ_MECHANICAL_INSPECTION
  VEHICLE_OWNERSHIP_PROOF
  ACCESSIBILITY_CERTIFICATION
  COMMERCIAL_PLATE_REGISTRATION
  VEHICLE_PHOTO

  @@map("quebec_vehicle_document_type")
}

// One row per driver. Sensitive fields (SAAQ licence number, legal name, VIN-adjacent identity data)
// are stored encrypted at rest (same AES-256-GCM helper as TaxProfile -- server/lib/tax-encryption.mjs)
// and only ever surfaced to API consumers as a masked last-4 display, never in full -- see
// redactQuebecDriverOnboarding in quebec-driver-onboarding.mjs. Date of birth is deliberately NOT
// stored at all: age/eligibility is a self-attestation boolean (ageEligibilityConfirmed) rather than a
// real birthdate, since no code path in Phase 1 needs the actual date -- storing less sensitive data
// than a masked/encrypted representation would require is itself the more privacy-preserving design.
// statusHistory is NOT stored on this row: every transition is written to AdminAuditLog (entityType
// 'quebec_driver_onboarding') instead, which is already immutable/append-only and audited the same way
// as every other compliance action in this codebase. version is bumped on every transition/edit as a
// lightweight change counter surfaced alongside the AdminAuditLog trail, not an optimistic-lock guard.
model QuebecDriverOnboarding {
  id                           String                       @id @default(uuid())
  userId                       String                       @unique @map("user_id")
  status                       QuebecDriverOnboardingStatus @default(DRAFT)
  legalNameEncrypted           String?                      @map("legal_name_encrypted")
  legalNameLast4               String?                      @map("legal_name_last4")
  ageEligibilityConfirmed      Boolean                      @default(false) @map("age_eligibility_confirmed")
  licenseNumberEncrypted       String?                      @map("license_number_encrypted")
  licenseClass                 String?                      @map("license_class")
  licenseExpiresAt             DateTime?                    @map("license_expires_at")
  drivingExperienceConfirmed   Boolean                      @default(false) @map("driving_experience_confirmed")
  drivingExperienceConfirmedAt DateTime?                    @map("driving_experience_confirmed_at")
  frenchAttestationConfirmed   Boolean                      @default(false) @map("french_attestation_confirmed")
  frenchAttestationConfirmedAt DateTime?                    @map("french_attestation_confirmed_at")
  policeCheckExpiresAt         DateTime?                    @map("police_check_expires_at")
  trainingCompletedAt          DateTime?                    @map("training_completed_at")
  gstStatus                    QuebecComplianceItemStatus   @default(NOT_STARTED) @map("gst_status")
  qstStatus                    QuebecComplianceItemStatus   @default(NOT_STARTED) @map("qst_status")
  operatorFileStatus           QuebecComplianceItemStatus   @default(NOT_STARTED) @map("operator_file_status")
  sevSrsStatus                 QuebecComplianceItemStatus   @default(NOT_STARTED) @map("sev_srs_status")
  statusReason                 String?                      @map("status_reason")
  assignedReviewerId           String?                      @map("assigned_reviewer_id")
  reviewedById                 String?                      @map("reviewed_by_id")
  reviewedAt                   DateTime?                    @map("reviewed_at")
  version                      Int                          @default(1)
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")

  driverProfile    DriverProfile          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reviewer         User?                  @relation("QuebecDriverOnboardingReviewer", fields: [reviewedById], references: [id])
  assignedReviewer User?                  @relation("QuebecDriverOnboardingAssignedReviewer", fields: [assignedReviewerId], references: [id])
  documents        QuebecDriverDocument[]

  @@index([status])
  @@map("quebec_driver_onboarding")
}

// One row per vehicle (links to the existing DriverVehicle row rather than duplicating
// make/model/plate). Same masking/audit discipline as QuebecDriverOnboarding -- VIN is stored
// encrypted and masked-by-default (redactQuebecVehicleOnboarding), never returned in full to a
// driver-facing endpoint.
model QuebecVehicleOnboarding {
  id                    String                        @id @default(uuid())
  vehicleId             String                        @unique @map("vehicle_id")
  status                QuebecVehicleOnboardingStatus @default(DRAFT)
  vinEncrypted          String?                       @map("vin_encrypted")
  vinLast4              String?                       @map("vin_last4")
  odometerKm            Int?                          @map("odometer_km")
  doorCount             Int?                          @map("door_count")
  seatCount             Int?                          @map("seat_count")
  accessibilityInfo     Json?                         @map("accessibility_info")
  registrationExpiresAt DateTime?                     @map("registration_expires_at")
  insuranceExpiresAt    DateTime?                     @map("insurance_expires_at")
  inspectionExpiresAt   DateTime?                     @map("inspection_expires_at")
  statusReason          String?                       @map("status_reason")
  assignedReviewerId    String?                       @map("assigned_reviewer_id")
  reviewedById          String?                       @map("reviewed_by_id")
  reviewedAt            DateTime?                     @map("reviewed_at")
  version               Int                           @default(1)
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")

  vehicle          DriverVehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reviewer         User?                   @relation("QuebecVehicleOnboardingReviewer", fields: [reviewedById], references: [id])
  assignedReviewer User?                   @relation("QuebecVehicleOnboardingAssignedReviewer", fields: [assignedReviewerId], references: [id])
  documents        QuebecVehicleDocument[]

  @@index([status])
  @@map("quebec_vehicle_onboarding")
}

// Versioned driver compliance documents. Uploading a new file never overwrites or deletes the
// previous row: the old row's isCurrent flips to false and stays exactly as it was (including a
// legal hold, if one is set); the new row is inserted with version = old.version + 1 and
// replacesId pointing back at it. "Current" for display/eligibility purposes is always the single
// row with isCurrent = true for a given (driverUserId, type) -- enforced in application code inside
// a transaction (server/lib/quebec-document-compliance.mjs), not by a DB constraint, so a legal hold
// can coexist with a newer active version. Retention/legal-hold/deletion fields mirror
// ListingDocument exactly (same reasoning: server/lib/listing-document-retention.mjs).
// malwareScanStatus stays PENDING under every current code path -- no scanner integration exists.
model QuebecDriverDocument {
  id                   String                   @id @default(uuid())
  onboardingUserId     String                   @map("onboarding_user_id")
  type                 QuebecDriverDocumentType
  version              Int                      @default(1)
  isCurrent            Boolean                  @default(true) @map("is_current")
  replacesId           String?                  @unique @map("replaces_id")
  assetUrl             String?                  @map("asset_url")
  mimeType             String?                  @map("mime_type")
  status               ListingDocumentStatus    @default(PENDING_REVIEW)
  issuer               String?
  issuedAt             DateTime?                @map("issued_at")
  expiresAt            DateTime?                @map("expires_at")
  uploadedAt           DateTime                 @default(now()) @map("uploaded_at")
  reviewedById         String?                  @map("reviewed_by_id")
  reviewedAt           DateTime?                @map("reviewed_at")
  rejectionReason      String?                  @map("rejection_reason")
  malwareScanStatus    MalwareScanStatus        @default(PENDING) @map("malware_scan_status")
  retentionDeleteAfter DateTime?                @map("retention_delete_after")
  legalHold            Boolean                  @default(false) @map("legal_hold")
  legalHoldReason      String?                  @map("legal_hold_reason")
  legalHoldSetById     String?                  @map("legal_hold_set_by_id")
  legalHoldSetAt       DateTime?                @map("legal_hold_set_at")
  deletedAt            DateTime?                @map("deleted_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  onboarding     QuebecDriverOnboarding @relation(fields: [onboardingUserId], references: [userId], onDelete: Cascade)
  reviewer       User?                  @relation("QuebecDriverDocumentReviewer", fields: [reviewedById], references: [id])
  legalHoldSetBy User?                  @relation("QuebecDriverDocumentLegalHoldSetBy", fields: [legalHoldSetById], references: [id])
  replaces       QuebecDriverDocument?  @relation("QuebecDriverDocumentReplaces", fields: [replacesId], references: [id])
  replacedBy     QuebecDriverDocument?  @relation("QuebecDriverDocumentReplaces")

  @@index([onboardingUserId, type, isCurrent])
  @@index([status])
  @@index([retentionDeleteAfter])
  @@map("quebec_driver_documents")
}

// Versioned vehicle compliance documents -- same versioning/legal-hold/retention design as
// QuebecDriverDocument above.
model QuebecVehicleDocument {
  id                   String                    @id @default(uuid())
  onboardingVehicleId  String                    @map("onboarding_vehicle_id")
  type                 QuebecVehicleDocumentType
  version              Int                       @default(1)
  isCurrent            Boolean                   @default(true) @map("is_current")
  replacesId           String?                   @unique @map("replaces_id")
  assetUrl             String?                   @map("asset_url")
  mimeType             String?                   @map("mime_type")
  status               ListingDocumentStatus     @default(PENDING_REVIEW)
  issuer               String?
  issuedAt             DateTime?                 @map("issued_at")
  expiresAt            DateTime?                 @map("expires_at")
  uploadedAt           DateTime                  @default(now()) @map("uploaded_at")
  reviewedById         String?                   @map("reviewed_by_id")
  reviewedAt           DateTime?                 @map("reviewed_at")
  rejectionReason      String?                   @map("rejection_reason")
  malwareScanStatus    MalwareScanStatus         @default(PENDING) @map("malware_scan_status")
  retentionDeleteAfter DateTime?                 @map("retention_delete_after")
  legalHold            Boolean                   @default(false) @map("legal_hold")
  legalHoldReason      String?                   @map("legal_hold_reason")
  legalHoldSetById     String?                   @map("legal_hold_set_by_id")
  legalHoldSetAt       DateTime?                 @map("legal_hold_set_at")
  deletedAt            DateTime?                 @map("deleted_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  onboarding     QuebecVehicleOnboarding @relation(fields: [onboardingVehicleId], references: [vehicleId], onDelete: Cascade)
  reviewer       User?                   @relation("QuebecVehicleDocumentReviewer", fields: [reviewedById], references: [id])
  legalHoldSetBy User?                   @relation("QuebecVehicleDocumentLegalHoldSetBy", fields: [legalHoldSetById], references: [id])
  replaces       QuebecVehicleDocument?  @relation("QuebecVehicleDocumentReplaces", fields: [replacesId], references: [id])
  replacedBy     QuebecVehicleDocument?  @relation("QuebecVehicleDocumentReplaces")

  @@index([onboardingVehicleId, type, isCurrent])
  @@index([status])
  @@index([retentionDeleteAfter])
  @@map("quebec_vehicle_documents")
}

model Location {
  id          String                               @id @default(uuid())
  country     String                               @default("SY")
  governorate String
  city        String
  area        String?
  street      String?
  addressLine String?                              @map("address_line")
  geo         Unsupported("geometry(Point,4326)")?
  createdAt   DateTime                             @default(now()) @map("created_at")

  listings     Listing[]
  pickupRides  RideRequest[] @relation("RidePickup")
  dropoffRides RideRequest[] @relation("RideDropoff")

  @@index([governorate, city])
  @@map("locations")
}

model Listing {
  id                 String          @id @default(uuid())
  ownerId            String          @map("owner_id")
  locationId         String?         @map("location_id")
  accommodationId    String?         @map("accommodation_id")
  division           ListingDivision
  titleAr            String          @map("title_ar")
  titleEn            String?         @map("title_en")
  description        String?
  status             ListingStatus   @default(DRAFT)
  priceMinor         Int             @map("price_minor")
  currency           String          @default("SYP")
  instantBookEnabled Boolean         @default(false) @map("instant_book_enabled")
  expiresAt          DateTime?       @map("expires_at")
  metadata           Json            @default("{}")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  owner          User                  @relation("ListingOwner", fields: [ownerId], references: [id])
  location       Location?             @relation(fields: [locationId], references: [id])
  accommodation  Accommodation?        @relation(fields: [accommodationId], references: [id])
  media          ListingMedia[]
  bookings       Booking[]
  availability   ListingAvailability[]
  reviews        ListingReview[]
  inquiryThreads MessageThread[]
  hostInsights   HostInsight[]
  sales          SellerSale[]
  documents      ListingDocument[]

  @@index([division, status])
  @@index([ownerId])
  @@index([accommodationId])
  @@map("listings")
}

// Groups multiple STAYS room-type Listings under one physical property (a hotel-like host's
// Studio/Suite/Double-Queen etc.), so shared location/documents/photos aren't re-collected per
// room type. Each child Listing keeps its own independent price, availability, and bookings.
model Accommodation {
  id          String        @id @default(uuid())
  ownerId     String        @map("owner_id")
  titleAr     String        @map("title_ar")
  titleEn     String?       @map("title_en")
  description String?
  governorate String
  city        String
  area        String?
  address     String?
  status      ListingStatus @default(DRAFT)
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  owner    User                 @relation("AccommodationOwner", fields: [ownerId], references: [id])
  listings Listing[]
  media    AccommodationMedia[]

  @@index([ownerId])
  @@map("accommodations")
}

model AccommodationMedia {
  id              String   @id @default(uuid())
  accommodationId String   @map("accommodation_id")
  url             String
  kind            String
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@index([accommodationId])
  @@map("accommodation_media")
}

// AI-generated pricing/availability insight for a host, e.g. "you have N open nights next month
// with no discount set." Generation is a manual, host-triggered action (real per-call AI cost),
// not opportunistic — see server/lib/host-insights.mjs.
model HostInsight {
  id          String    @id @default(uuid())
  hostId      String    @map("host_id")
  listingId   String?   @map("listing_id")
  kind        String    @default("PRICING_GAP")
  facts       Json      @default("{}")
  messageAr   String    @map("message_ar")
  messageEn   String?   @map("message_en")
  aiProvider  String?   @map("ai_provider")
  aiModel     String?   @map("ai_model")
  readAt      DateTime? @map("read_at")
  emailSentAt DateTime? @map("email_sent_at")
  emailError  String?   @map("email_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  host    User     @relation("HostInsightOwner", fields: [hostId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([hostId, createdAt])
  @@index([listingId])
  @@map("host_insights")
}

// Real, server-verified email one-time codes for pre-registration guest identity checks (replaces
// the old client-only phone-code simulation in GuestAccountPage). code_hash is a fast HMAC, not a
// slow KDF — matching the 6-digit/short-TTL/attempt-limited nature of an OTP, not a password.
model EmailVerificationCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  purpose    String    @default("guest-signup")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("email_verification_codes")
}

// SMS/phone one-time codes (022) — same OTP security model as EmailVerificationCode, delivered by SMS.
// Sign-up / sign-in accepts a recently-verified email OR phone, so users can verify by whichever channel.
model PhoneVerificationCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String    @default("guest-signup")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("phone_verification_codes")
}

model ListingAvailability {
  id                 String             @id @default(uuid())
  listingId          String             @map("listing_id")
  date               DateTime           @db.Date
  status             AvailabilityStatus @default(BLOCKED)
  priceOverrideMinor Int?               @map("price_override_minor")
  note               String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId, date])
  @@map("listing_availability")
}

model ListingMedia {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  url       String
  kind      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_media")
}

model Booking {
  id                String        @id @default(uuid())
  listingId         String        @map("listing_id")
  guestId           String        @map("guest_id")
  status            BookingStatus @default(REQUESTED)
  checkIn           DateTime?     @map("check_in")
  checkOut          DateTime?     @map("check_out")
  amountMinor       Int           @map("amount_minor")
  currency          String        @default("SYP")
  metadata          Json          @default("{}")
  guestCheckedInAt  DateTime?     @map("guest_checked_in_at")
  guestCheckedOutAt DateTime?     @map("guest_checked_out_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  listing       Listing        @relation(fields: [listingId], references: [id])
  guest         User           @relation("BookingGuest", fields: [guestId], references: [id])
  payments      PaymentProof[]
  review        ListingReview?
  messageThread MessageThread?
  disputes      Dispute[]
  payment       Payment?
  payout        Payout?

  @@index([guestId, status])
  @@index([listingId, status])
  @@map("bookings")
}

// ============ Financial statement records (031 / M5) ============
// A Payment is the FROZEN, immutable financial statement for one settled booking — captured once at the
// paid→settlement transition (approvePaymentProof) from the pure bookingFinanceSplit + the M8 tax capsule,
// then never recomputed. Statements and totals RENDER FROM THIS RECORD so an already-issued booking keeps
// its terms even if the commission policy rate later changes (this closes the M2 retroactive-restatement
// gap). Money is integer minor units + a currency; the commission rate is frozen as parts-per-million
// (1% = 10,000 parts) alongside the M6 host-contract baseVersion the guest/host actually agreed to.
model Payment {
  id                    String   @id @default(uuid())
  bookingId             String   @unique @map("booking_id")
  grossMinor            Int      @map("gross_minor") // the guest's all-inclusive paid total
  accommodationMinor    Int      @default(0) @map("accommodation_minor") // itemized so a statement renders fully from this record
  cleaningFeeMinor      Int      @default(0) @map("cleaning_fee_minor")
  extraFeesMinor        Int      @default(0) @map("extra_fees_minor")
  processingFeeMinor    Int      @default(0) @map("processing_fee_minor") // card-processing fee withheld from the host net
  commissionBaseMinor   Int      @map("commission_base_minor") // M2 base = accommodation + cleaning only
  commissionRateParts   Int      @map("commission_rate_parts") // frozen rate, parts-per-million
  commissionAmountMinor Int      @map("commission_amount_minor") // platform take on the base
  hostPayoutMinor       Int      @map("host_payout_minor") // host gross before any processing fee
  taxComponents         Json     @default("[]") @map("tax_components") // [{name, rateParts, calculationBase, amountMinor}]
  taxTotalMinor         Int      @default(0) @map("tax_total_minor") // Σ tax components (pass-through, never in commission base)
  currency              String
  settlementRef         String   @map("settlement_ref") // real Stripe capture id / Sham Cash proof id (R8)
  baseVersion           String   @map("base_version") // M6 STR_HOST_CONTRACT_VERSION, or 'legacy-unversioned' for backfilled pre-M6
  status                String   @default("SETTLED") // SETTLED | REFUNDED
  source                String   @default("live") // 'live' (written at settlement) | 'backfill' (from pre-M5 records)
  settledAt             DateTime @default(now()) @map("settled_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, settledAt])
  @@map("payments")
}

// A Payout is the host-facing side of the same settlement: the frozen net amount owed to the host and its
// release lifecycle. Release/reversal are explicit admin actions, each audited in AdminAuditLog.
model Payout {
  id           String    @id @default(uuid())
  bookingId    String    @unique @map("booking_id")
  hostId       String    @map("host_id")
  amountMinor  Int       @map("amount_minor") // frozen host net payout
  currency     String
  status       String    @default("PENDING_HOLD") // PENDING_HOLD | ELIGIBLE | RELEASED | REVERSED
  releaseDate  DateTime? @map("release_date")
  releasedById String?   @map("released_by_id")
  source       String    @default("live") // 'live' | 'backfill'
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  host    User    @relation("PayoutHost", fields: [hostId], references: [id])

  @@index([hostId, status])
  @@index([status, releaseDate])
  @@map("payouts")
}

model PaymentProof {
  id            String        @id @default(uuid())
  bookingId     String?       @map("booking_id")
  userId        String        @map("user_id")
  provider      String
  status        PaymentStatus @default(PENDING_PROOF)
  amountMinor   Int           @map("amount_minor")
  currency      String        @default("SYP")
  proofAssetUrl String?       @map("proof_asset_url")
  providerRef   String?       @map("provider_ref")
  adminNote     String?       @map("admin_note")
  reviewedById  String?       @map("reviewed_by_id")
  reviewedAt    DateTime?     @map("reviewed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id])
  payer   User     @relation("PaymentPayer", fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("payment_proofs")
}

model ListingReview {
  id              String    @id @default(uuid())
  listingId       String    @map("listing_id")
  bookingId       String    @unique @map("booking_id")
  guestId         String    @map("guest_id")
  rating          Int
  comment         String?
  hiddenAt        DateTime? @map("hidden_at")
  hiddenByAdminId String?   @map("hidden_by_admin_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest   User    @relation("ReviewGuest", fields: [guestId], references: [id])

  @@index([listingId, hiddenAt])
  @@map("listing_reviews")
}

// Marketplace seller reputation (Block 3). Unlike STAYS (reviewed off a completed Booking), cars/
// property/goods are contact-based, so a review is gated on the SELLER first confirming a real sale
// to a specific buyer. SellerSale is that confirmation; SellerReview is the buyer's one rating of it.
model SellerSale {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  sellerId  String   @map("seller_id")
  buyerId   String   @map("buyer_id")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller  User          @relation("SellerSaleSeller", fields: [sellerId], references: [id])
  buyer   User          @relation("SellerSaleBuyer", fields: [buyerId], references: [id])
  review  SellerReview?

  // One confirmed sale per (listing, buyer) — a seller can't stack multiple review-grants on one buyer.
  @@unique([listingId, buyerId])
  @@index([sellerId])
  @@map("seller_sales")
}

model SellerReview {
  id        String    @id @default(uuid())
  saleId    String    @unique @map("sale_id")
  sellerId  String    @map("seller_id")
  buyerId   String    @map("buyer_id")
  rating    Int
  comment   String?
  hiddenAt  DateTime? @map("hidden_at")
  createdAt DateTime  @default(now()) @map("created_at")

  sale   SellerSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  seller User       @relation("SellerReviewSeller", fields: [sellerId], references: [id])
  buyer  User       @relation("SellerReviewBuyer", fields: [buyerId], references: [id])

  @@index([sellerId, hiddenAt])
  @@map("seller_reviews")
}

model MessageThread {
  id        String   @id @default(uuid())
  bookingId String?  @unique @map("booking_id")
  listingId String?  @map("listing_id")
  guestId   String?  @map("guest_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing   Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest     User?            @relation("ListingInquiryGuest", fields: [guestId], references: [id], onDelete: Cascade)
  messages  Message[]
  documents ThreadDocument[]

  @@unique([listingId, guestId])
  @@map("message_threads")
}

model Message {
  id           String            @id @default(uuid())
  threadId     String            @map("thread_id")
  senderUserId String            @map("sender_user_id")
  senderRole   MessageSenderRole @map("sender_role")
  body         String
  createdAt    DateTime          @default(now()) @map("created_at")

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderUserId], references: [id])

  @@index([threadId, createdAt])
  @@map("messages")
}

// Real per-thread document uploads (025) -- replaces the previous behavior where "uploading" a
// rental/purchase-request document on the Rentals/Buy page only captured the filename and pasted
// it into a chat message, never storing the actual file. Attached to a MessageThread (shared by
// booking threads and listing-inquiry threads) so it works for any thread-based conversation, but
// today only the listing-inquiry thread routes (server/routes/messages.mjs) write/read it.
model ThreadDocument {
  id               String   @id @default(uuid())
  threadId         String   @map("thread_id")
  uploaderUserId   String   @map("uploader_user_id")
  assetUrl         String   @map("asset_url")
  mimeType         String   @map("mime_type")
  originalFilename String?  @map("original_filename")
  createdAt        DateTime @default(now()) @map("created_at")

  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  uploader User          @relation("ThreadDocumentUploader", fields: [uploaderUserId], references: [id])

  @@index([threadId, createdAt])
  @@map("thread_documents")
}

model Wallet {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  currency           String   @default("SYP")
  cachedBalanceMinor Int      @default(0) @map("cached_balance_minor")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries WalletEntry[]

  @@unique([userId, currency])
