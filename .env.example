# SYBNB V6 — environment template. Copy to .env and fill in real values.
# .env is git-ignored — never commit real secrets. This file must only ever contain placeholders.
# (Security audit finding F-16.)

# --- Database ---
# Local Postgres connection string. Never point this at a production database from a dev machine.
DATABASE_URL="postgresql://user@127.0.0.1:5432/sybnb_v6"

# --- Auth secrets (server-side only, never exposed to the frontend) ---
# Any long random string. Rotating this invalidates every currently-issued session token.
AUTH_SECRET="replace-with-a-long-random-value"
# HMAC key used to hash phone numbers before storage. Also any long random string.
PHONE_HASH_SECRET="replace-with-a-different-long-random-value"

# --- Server ---
API_PORT=3051
API_HOST=127.0.0.1
# Comma-separated list of allowed frontend origins for CORS. In production this must be the real
# deployed frontend origin(s) — the built-in dev-only fallback list (127.0.0.1/localhost ports)
# must never be relied on outside local development.
CORS_ORIGIN="http://127.0.0.1:5180"

# --- Rate limiting (server/lib/rate-limit.mjs) ---
# Set to 1 only when this server sits behind a proxy/load balancer you control, so it's safe to
# trust the client-supplied X-Forwarded-For header for rate-limit bucketing. Leave unset/0 for
# local dev and any direct-exposed deployment.
TRUST_PROXY=0
# Set to 1 to disable rate limiting entirely (e.g. for local load testing). Never set this in
# production.
DISABLE_RATE_LIMIT=0

# --- Production hardening flags ---
# Set to "production" to enable production-only behavior (currently: allows HSTS to be set).
NODE_ENV=development
# Set to 1 only once this server is actually served over HTTPS (typically via a reverse proxy
# terminating TLS in front of it) — setting this while served over plain HTTP would have browsers
# incorrectly remember to force HTTPS for this host.
FORCE_HTTPS=0

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_CURRENCY="usd"
SYP_PER_USD=15000
# Publishable keys are designed to be public/client-exposed — this is intentionally VITE_-prefixed
# so Vite bundles it into the frontend build.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
